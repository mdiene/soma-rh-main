{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifeste de module métier SOMA-RH (socle M0)",
  "description": "Valide ce que le chargeur utilise : identité, version et paramètres avec statut légal. Les autres sections (custom_fields, planning_rules, calculation_rules, compliance_checks, tests…) sont tolérées telles quelles : leur structure sera harmonisée en M2/M3. Un paramètre to_provide peut avoir une valeur provisoire ou null ; il n'est jamais pré-rempli.",
  "type": "object",
  "required": ["manifest_version", "module_id", "module_name", "version", "parameters"],
  "properties": {
    "manifest_version": { "type": "string", "enum": ["1.0", "2.0"] },
    "module_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "module_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "status": { "type": "string", "enum": ["draft", "prototype", "deployed", "deprecated"] },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "requires_core": { "type": "string" },
    "custom_fields": { "type": ["array", "object"] },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["legal_status"],
        "properties": {
          "legal_status": { "type": "string", "enum": ["verified", "secondary", "to_provide"] },
          "source": { "type": "string" },
          "unit": { "type": "string" },
          "note": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "legal_status": { "enum": ["verified", "secondary"] } } },
            "then": { "required": ["source"] }
          }
        ]
      }
    }
  }
}
