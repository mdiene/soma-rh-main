# Version EN LIGNE : ne pas renseigner ici. Définir ces variables dans Vercel (Settings > Environment Variables),
# ou copier ce fichier en web/.env.production.local (ignoré par Git) pour un build local.
# Supabase > Project Settings > API : URL du projet et clé publique « anon » (jamais la clé service_role).
VITE_API_URL=https://<ref-du-projet>.supabase.co
VITE_API_PUBLIC_KEY=<cle-anon-publique>
VITE_DOCUMENTS_MODE=supabase
